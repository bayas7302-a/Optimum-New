# Apache / LiteSpeed hosting (Azure uses staticwebapp.config.json instead)
Options -MultiViews -Indexes
DirectoryIndex index.html

RewriteEngine On
# /about -> about.html, /ar/contact -> ar/contact.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Keep the Azure function source and config private on Apache hosts
<FilesMatch "^(staticwebapp\.config\.json|host\.json|package\.json|function\.json|local\.settings\.json.*)$">
  Require all denied
</FilesMatch>
RedirectMatch 403 /api/.*\.js$
